{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://omochix.com/schemas/learn-motion-catalog-v1.json",
  "title": "OmochiX Learn Motion Gallery catalog",
  "description": "Theme-shipped catalog of motion samples shown under /learn/motion/. The PHP validator in inc/learn-gallery.php mirrors the required/enum rules below; keep both in sync.",
  "type": "object",
  "required": ["version", "updated", "stage", "categories", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "stage": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 120, "maximum": 1920 },
        "height": { "type": "integer", "minimum": 80, "maximum": 1080 }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "name", "description", "order"],
        "additionalProperties": false,
        "properties": {
          "slug": { "$ref": "#/definitions/slug" },
          "name": { "type": "string", "minLength": 1, "maxLength": 40 },
          "description": { "type": "string", "maxLength": 200 },
          "order": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/item" }
    }
  },
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 60 },
    "item": {
      "type": "object",
      "required": ["id", "slug", "category", "name", "summary", "description", "level", "tech", "tags", "preview", "prompt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]{3}$" },
        "slug": { "$ref": "#/definitions/slug" },
        "category": { "$ref": "#/definitions/slug" },
        "name": {
          "type": "object",
          "required": ["ja", "en"],
          "additionalProperties": false,
          "properties": {
            "ja": { "type": "string", "minLength": 1, "maxLength": 40 },
            "en": { "type": "string", "minLength": 1, "maxLength": 60 }
          }
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 300 },
        "level": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
        "tech": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "enum": ["css", "js"] } },
        "tags": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 30 } },
        "featured": { "type": "boolean" },
        "preview": {
          "type": "object",
          "required": ["html", "css"],
          "additionalProperties": false,
          "properties": {
            "html": { "type": "string", "minLength": 1, "maxLength": 8000 },
            "css": { "type": "string", "maxLength": 12000 },
            "js": { "type": "string", "maxLength": 12000 }
          }
        },
        "prompt": {
          "type": "object",
          "required": ["ask", "spec", "use"],
          "additionalProperties": false,
          "properties": {
            "ask": { "type": "string", "minLength": 1, "maxLength": 300 },
            "spec": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
            "use": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        },
        "related": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompts": { "type": "array", "items": { "$ref": "#/definitions/slug" } },
            "tools": { "type": "array", "items": { "$ref": "#/definitions/slug" } },
            "learn": { "type": "array", "items": { "type": "string", "pattern": "^learn(?:/[a-z0-9-]+)+$" } }
          }
        },
        "playground": {
          "description": "Playground parameters (Phase 2). Each parameter is typed, has a default equal to the shipped look, and binds to a --p-* CSS custom property that the sample's CSS reads with a fallback (target css), or to window.omxParams for JS samples (target js). The PHP validator in inc/learn-gallery.php mirrors these rules.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "params": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "required": ["key", "label", "type", "default"],
                "additionalProperties": false,
                "properties": {
                  "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,23}$" },
                  "label": { "type": "string", "minLength": 1, "maxLength": 30 },
                  "type": { "type": "string", "enum": ["range", "color", "select"] },
                  "target": { "type": "string", "enum": ["css", "js"], "default": "css" },
                  "min": { "type": "number" },
                  "max": { "type": "number" },
                  "step": { "type": "number", "exclusiveMinimum": 0 },
                  "options": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "required": ["value", "label"],
                      "additionalProperties": false,
                      "properties": {
                        "value": { "type": "string", "pattern": "^[a-z0-9_-]{1,24}$" },
                        "label": { "type": "string", "minLength": 1, "maxLength": 30 },
                        "css": { "type": "string", "pattern": "^[A-Za-z0-9 .,()%#-]{1,80}$" }
                      }
                    }
                  },
                  "default": {},
                  "unit": { "type": "string", "enum": ["", "ms", "s", "px", "deg", "%", "em", "rem", "vw", "vh"] },
                  "css_var": { "type": "string", "pattern": "^--p-[a-z0-9-]{1,30}$" },
                  "prompt": { "type": "string", "maxLength": 120, "pattern": "\\{value\\}" }
                }
              }
            }
          }
        },
        "video": {
          "description": "Reserved for OmochiX Video integration. Validated for shape only.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "enum": ["youtube"] },
            "id": { "type": "string" },
            "start": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
