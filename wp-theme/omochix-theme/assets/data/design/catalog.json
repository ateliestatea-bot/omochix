      "materials": [
        {
          "name": "システムフォント",
          "type": "font",
          "source": "system",
          "license": "system-font"
        },
        {
          "name": "CSS・SVG・JavaScript（自作）",
          "type": "code",
          "source": "original",
          "license": "original"
        }
      ],
      "customization": [
        {
          "label": "アクセント色",
          "description": "グラフと強調タイルの色"
        },
        {
          "label": "角丸",
          "description": "タイルとボタンの角の丸み"
        },
        {
          "label": "タイルの間隔",
          "description": "グリッドの gap"
        }
      ],
      "prompt": {
        "text": "大きさの違うタイルを組み合わせた Bento グリッドで、SaaS の機能を一覧できる LP を作ってください。折れ線グラフ、KPI の数値、担当ごとの棒グラフ、ミニボード、連携アイコン（汎用の図形のみ）、料金表 3 プラン。タイルは画面に入ると順に出現し、数値はカウントアップ、グラフは線が描かれます。ホバーでタイルを少し拡大して影を付けます。prefers-reduced-motion では最終状態で表示し、数値と価格は架空であることを明記してください。"
      },
      "steps": [
        {
          "title": "タイルを配置する",
          "body": "6 列のグリッドで、グラフは 4 列 × 2 行、数値は 2 列など大きさを変えて並べ、幅に応じて 2 列・1 列に組み替える。"
        },
        {
          "title": "順に出す",
          "body": "IntersectionObserver で画面に入ったタイルから、少しずつ遅らせて opacity と transform を戻す。"
        },
        {
          "title": "数値とグラフを動かす",
          "body": "数値は 0 から最終値まで約 1.4 秒で数え上げる。折れ線は stroke-dashoffset、棒は scaleX で描く。"
        },
