{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omochix.local/schemas/design-catalog-v2.json",
  "title": "OmochiX Design Library catalog (v2, D1.5)",
  "description": "Mirrors omochix_design_validate_catalog() in inc/design-library.php. Rules a schema cannot express are checked by the PHP validator and tests/design-library/catalog-check.js: unique id and slug, id prefix = medium, only web and video may be published, asset/demo paths bound to the slug and present on disk, video fields only for medium video, deliverables.html only for medium web and = preview.entry, sha256 = tools/design-library/demo-hash.js, a published item must be verified (state other than unverified) before its live demo is served.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "updated",
    "items"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "updated": {
      "$ref": "#/$defs/date"
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{1,46})[a-z0-9]$",
      "not": {
        "pattern": "--"
      }
    },
    "slugList": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f<>]"
      }
    },
    "longText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "not": {
        "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f<>]"
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "medium",
        "status",
        "title",
        "summary",
        "description",
        "use_cases",
        "motion_types",
        "technologies",
        "styles",
        "motions",
        "industries",
        "level",
        "palette",
        "fonts",
        "poster",
        "preview",
        "materials",
        "customization",
        "credits",
        "verification",
        "related",
        "audit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^dl-(web|video|app|component)-[0-9]{4}$"
        },
        "slug": {
          "$ref": "#/$defs/slug"
        },
        "medium": {
          "enum": [
            "web",
            "video",
            "app",
            "component"
          ]
        },
        "status": {
          "enum": [
            "draft",
            "published"
          ]
        },
        "title": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "maxLength": 60
            }
          ]
        },
        "access": {
          "description": "G14 PREVIEW. Optional; absent = scope preview + distribution disabled (the full prompt and code are not printed). Allowed pairs: preview + disabled, full + disabled, full + free (the detail page prints the prompt and code), full + paid (stays closed until a server-side purchase check exists). PRIVATE is status draft, not an access value. The pair rule is checked by the PHP validator and tests/design-library/catalog-check.js.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "distribution"
          ],
          "properties": {
            "scope": {
              "enum": [
                "preview",
                "full"
              ]
            },
            "distribution": {
              "enum": [
                "disabled",
                "free",
                "paid"
              ]
            }
          }
        },
        "fictionalBrand": {
          "description": "The fictional brand name shown inside the work (detail notice N3, poster alt N6, structured data N7). Optional: only when the work's own content shows a brand name; never invented.",
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "maxLength": 40
            }
          ]
        },
        "summary": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "maxLength": 160
            }
          ]
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "maxLength": 200
            }
          ]
        },
        "use_cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "lp",
              "corporate",
              "product",
              "saas",
              "media",
              "portfolio",
              "brand-intro",
              "sns-short",
              "explainer",
              "presentation"
            ]
          }
        },
        "motion_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "scroll",
              "3d",
              "typography",
              "logo",
              "chart",
              "pointer",
              "transition",
              "ambient",
              "ui"
            ]
          }
        },
        "technologies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "html",
              "css",
              "js",
              "svg",
              "webgl",
              "canvas",
              "ffmpeg",
              "remotion",
              "blender"
            ]
          }
        },
        "styles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "glass",
              "gradient",
              "dark",
              "light",
              "minimal",
              "editorial",
              "typography",
              "monochrome",
              "immersive",
              "3d",
              "bento",
              "dashboard"
            ]
          }
        },
        "motions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pointer-follow",
              "float",
              "scroll-linked",
              "parallax",
              "text-reveal",
              "line-draw",
              "page-transition",
              "drag-rotate",
              "camera-scroll",
              "assemble",
              "stagger",
              "hover-lift",
              "count-up",
              "chart-draw",
              "logo-draw"
            ]
          }
        },
        "industries": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "level": {
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ]
        },
        "palette": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "allOf": [
                  {
                    "$ref": "#/$defs/text"
                  },
                  {
                    "maxLength": 24
                  }
                ]
              },
              "value": {
                "type": "string",
                "pattern": "^#[0-9a-f]{6}$"
              }
            }
          }
        },
        "fonts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9 \\-]{0,39}$"
          }
        },
        "poster": {
          "type": "string",
          "pattern": "^posters/[a-z0-9-]+\\.avif$"
        },
        "posterFallback": {
          "type": "string",
          "pattern": "^posters/[a-z0-9-]+\\.webp$"
        },
        "loop": {
          "type": "string",
          "pattern": "^loops/[a-z0-9-]+\\.webm$"
        },
        "loopFallback": {
          "type": "string",
          "pattern": "^loops/[a-z0-9-]+\\.mp4$"
        },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mp4",
            "width",
            "height",
            "fps",
            "seconds"
          ],
          "properties": {
            "mp4": {
              "type": "string",
              "pattern": "^videos/[a-z0-9-]+\\.mp4$"
            },
            "webm": {
              "type": "string",
              "pattern": "^videos/[a-z0-9-]+\\.webm$"
            },
            "width": {
              "type": "integer",
              "minimum": 160,
              "maximum": 3840
            },
            "height": {
              "type": "integer",
              "minimum": 160,
              "maximum": 3840
            },
            "fps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "seconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 600
            }
          }
        },
        "preview": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "entry",
                "viewports",
                "scroll",
                "webgl"
              ],
              "properties": {
                "type": {
                  "const": "browser"
                },
                "entry": {
                  "type": "string",
                  "pattern": "^demos/[a-z0-9-]+/$"
                },
                "viewports": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "desktop",
                      "tablet",
                      "mobile"
                    ]
                  }
                },
                "scroll": {
                  "type": "boolean"
                },
                "webgl": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "orientation"
              ],
              "properties": {
                "type": {
                  "const": "video"
                },
                "orientation": {
                  "enum": [
                    "portrait",
                    "landscape",
                    "square"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "entry",
                "devices",
                "screens",
                "transitions",
                "theme"
              ],
              "properties": {
                "type": {
                  "const": "device"
                },
                "entry": {
                  "type": "string",
                  "pattern": "^demos/[a-z0-9-]+/$"
                },
                "devices": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "iphone",
                      "android"
                    ]
                  }
                },
                "screens": {
                  "type": "array",
                  "maxItems": 24,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/slug"
                  }
                },
                "transitions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "from",
                      "gesture",
                      "to"
                    ],
                    "properties": {
                      "from": {
                        "$ref": "#/$defs/slug"
                      },
                      "gesture": {
                        "enum": [
                          "tap",
                          "swipe",
                          "long-press"
                        ]
                      },
                      "to": {
                        "$ref": "#/$defs/slug"
                      }
                    }
                  }
                },
                "theme": {
                  "enum": [
                    "light",
                    "dark"
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "entry",
                "states",
                "stageSize",
                "interactions"
              ],
              "properties": {
                "type": {
                  "const": "stage"
                },
                "entry": {
                  "type": "string",
                  "pattern": "^demos/[a-z0-9-]+/$"
                },
                "states": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "default",
                      "hover",
                      "focus",
                      "active",
                      "disabled",
                      "loading"
                    ]
                  }
                },
                "stageSize": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "width",
                    "height"
                  ],
                  "properties": {
                    "width": {
                      "type": "integer",
                      "minimum": 120,
                      "maximum": 1920
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 80,
                      "maximum": 1200
                    }
                  }
                },
                "interactions": {
                  "type": "array",
                  "maxItems": 4,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "click",
                      "drag",
                      "toggle",
                      "scroll"
                    ]
                  }
                }
              }
            }
          ]
        },
        "materials": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "source",
              "license"
            ],
            "properties": {
              "name": {
                "allOf": [
                  {
                    "$ref": "#/$defs/text"
                  },
                  {
                    "maxLength": 60
                  }
                ]
              },
              "type": {
                "enum": [
                  "font",
                  "image",
                  "audio",
                  "video",
                  "library",
                  "data",
                  "code"
                ]
              },
              "source": {
                "enum": [
                  "original",
                  "system"
                ]
              },
              "license": {
                "enum": [
                  "original",
                  "system-font"
                ]
              }
            }
          }
        },
        "customization": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "description"
            ],
            "properties": {
              "label": {
                "allOf": [
                  {
                    "$ref": "#/$defs/text"
                  },
                  {
                    "maxLength": 40
                  }
                ]
              },
              "description": {
                "allOf": [
                  {
                    "$ref": "#/$defs/text"
                  },
                  {
                    "maxLength": 160
                  }
                ]
              }
            }
          }
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "$ref": "#/$defs/longText"
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "body"
            ],
            "properties": {
              "title": {
                "allOf": [
                  {
                    "$ref": "#/$defs/text"
                  },
                  {
                    "maxLength": 60
                  }
                ]
              },
              "body": {
                "allOf": [
                  {
                    "$ref": "#/$defs/longText"
                  },
                  {
                    "maxLength": 600
                  }
                ]
              }
            }
          }
        },
        "deliverables": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "html",
            "showCode"
          ],
          "properties": {
            "html": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "sha256"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "pattern": "^demos/[a-z0-9-]+/$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "showCode": {
              "type": "boolean"
            }
          }
        },
        "credits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "author",
            "source",
            "license"
          ],
          "properties": {
            "author": {
              "allOf": [
                {
                  "$ref": "#/$defs/text"
                },
                {
                  "maxLength": 60
                }
              ]
            },
            "source": {
              "const": "original"
            },
            "license": {
              "const": "original"
            },
            "notes": {
              "allOf": [
                {
                  "$ref": "#/$defs/text"
                },
                {
                  "maxLength": 200
                }
              ]
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "checked",
            "environments",
            "limitations"
          ],
          "properties": {
            "state": {
              "enum": [
                "unverified",
                "verified-local",
                "verified-production"
              ]
            },
            "checked": {
              "anyOf": [
                {
                  "$ref": "#/$defs/date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "environments": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "chromium",
                  "webkit",
                  "firefox",
                  "safari-macos",
                  "safari-ios",
                  "chrome-android",
                  "ffprobe"
                ]
              }
            },
            "limitations": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "allOf": [
                  {
                    "$ref": "#/$defs/text"
                  },
                  {
                    "maxLength": 160
                  }
                ]
              }
            }
          }
        },
        "related": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "designs",
            "motion",
            "learn",
            "prompts"
          ],
          "properties": {
            "designs": {
              "$ref": "#/$defs/slugList"
            },
            "motion": {
              "$ref": "#/$defs/slugList"
            },
            "learn": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^learn(/[a-z0-9-]+){1,3}$"
              }
            },
            "prompts": {
              "$ref": "#/$defs/slugList"
            }
          }
        },
        "motionStudio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "templateId",
            "status"
          ],
          "properties": {
            "templateId": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
            },
            "status": {
              "enum": [
                "unverified",
                "verified"
              ]
            },
            "settings": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "maxLength": 120,
                    "not": {
                      "pattern": "[\\u0000-\\u001f\\u007f<>]"
                    }
                  }
                ]
              }
            }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewed",
            "perf"
          ],
          "properties": {
            "reviewed": {
              "$ref": "#/$defs/date"
            },
            "perf": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "transferKb": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "jsKb": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "lcpMs": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "cls": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "longTasks": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "heapMb": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "fpsP5": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                }
              }
            }
          }
        }
      }
    }
  }
}
