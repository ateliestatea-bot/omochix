  "gates": {
    "B": {
      "after": [
        "theme",
        "style.css"
      ],
      "check": "Existing 31 URLs unchanged from 1.30.0 (navigation, search with suggestions, loader off, canonical and robots, sitemaps); /design/, /design/web/, /design/video/, a work detail, a demo URL and /design-sitemap.xml all answer 404 while no page with the slug design is published; Industry Hub hubs still 404 while private; Labs, SVG Motion Studio and the Learn card unchanged; all 95 files match the manifest."
    }
  },
  "rollback_order": [
    [
      "theme",
      "style.css"
    ],
    [
      "theme",
      "functions.php"
    ]
  ],
  "after_apply": [
    "Reset PHP opcache (LiteSpeed Cache: Toolbox > Purge All - Opcode Cache).",
    "Purge all LiteSpeed caches.",
    "Run gate B checks."
  ],
  "after_rollback": [
    "Before the files: if the page with the slug design was published, set it back to draft first (otherwise /design/... answers 200 with the plain page template once functions.php is restored).",
    "Reset PHP opcache and purge all LiteSpeed caches.",
    "Without --remove-added the 93 added files stay on the server: nothing loads them once functions.php is restored, but the posters, loops and videos stay reachable by their URLs; use --remove-added to remove them.",
    "The 4 Design Library rewrite rules stay in the database until Settings > Permalinks > Save regenerates them (a database change: needs its own approval). While no page with the slug design is published they lead to 404, except /design-sitemap.xml which answers 301 to a 404.",
    "Check the 31 existing URLs match the 1.30.0 state."
  ]
